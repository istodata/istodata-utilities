+            if (defined('ICL_SITEPRESS_VERSION') && ICL_SITEPRESS_VERSION === '4.9.7' &&
+                in_array($name, array('WPML_Elementor_Translate_IDs::translate_global_widget_ids',
+                    'WPML_Elementor_Translate_IDs::translate_product_ids', 'WPML_Elementor_Translate_IDs::translate_ids_in_widget_fields',
+                    'WPML\\PB\\Elementor\\Hooks\\DynamicElements::convert', 'WPML\\PB\\Elementor\\Hooks\\DisplayConditions::convertDisplayConditions',
+                    'WPML_Elementor_Adjust_Global_Widget_ID::duplicate_css_class_with_original_id',
+                    'WPML_Slug_Translation::filter_pre_get_posts', 'SitePress::pre_get_posts',
+                    'WPML_Display_As_Translated_Tax_Query::posts_where_filter',
+                    'WPML_Query_Filter::posts_where_filter', 'WPML_Query_Filter::posts_join_filter',
+                    'WPML_Media_Attachments_Query::adjust_attachment_query_action',
+                    'WPML_Elementor_WooCommerce_Hooks::do_not_suppress_filters_on_product_widget',
+                    'WPML\\PB\\Elementor\\V4\\Component\\QueryHooks::handleComponentQuery',
+                    'WPML_Nav_Menu::wp_nav_menu_args_filter', 'WPML_Nav_Menu::wp_nav_menu_items_filter',
+                    'WPML_LS_Render::add_menu_link_accessibility_attributes', 'WPML_URL_Filters::permalink_filter',
+                    'WPML_Slug_Translation::post_type_link_filter', 'WPML\\PB\\Elementor\\Hooks\\LandingPages::adjustLink'), true) &&
+                preg_match('~/(sitepress-multilingual-cms|wpml-string-translation|wpml-media-translation)/~', $file)) return true;
