--- /dev/null
+++ b/includes/elementor-fragment-cache-excerpt.php
@@ -0,0 +1,85 @@
+<?php
+/** Replay the reviewed Pro Classic skin's leaked excerpt filters, without render. */
+if (!defined('ABSPATH')) exit;
+
+final class IU_Elementor_Fragment_Excerpt {
+    public static function profile() {
+        $result = array();
+        foreach (array('excerpt_length', 'excerpt_more') as $hook) {
+            foreach (($GLOBALS['wp_filter'][$hook]->callbacks ?? array()) as $priority => $group) {
+                foreach ($group as $entry) {
+                    $fn = $entry['function'];
+                    $item = array('hook' => $hook, 'priority' => (int) $priority, 'args' => (int) $entry['accepted_args']);
+                    if ($item['args'] !== 1) return null;
+                    if ($hook === 'excerpt_more' && $fn === 'wp_embed_excerpt_more') {
+                        $item['kind'] = 'native';
+                    } elseif (defined('ELEMENTOR_PRO_VERSION') && ELEMENTOR_PRO_VERSION === '4.2.2' &&
+                        is_array($fn) && is_object($fn[0]) && get_class($fn[0]) === 'ElementorPro\\Modules\\Posts\\Skins\\Skin_Classic' &&
+                        $fn[1] === ($hook === 'excerpt_length' ? 'filter_excerpt_length' : 'filter_excerpt_more')) {
+                        $item['kind'] = 'classic';
+                        if ($hook === 'excerpt_length') {
+                            $item['length'] = $fn[0]->get_instance_value('excerpt_length');
+                            if (!self::length_ok($item['length'])) return null;
+                            $parent_property = new ReflectionProperty('Elementor\\Skin_Base', 'parent');
+                            if (PHP_VERSION_ID < 80100) $parent_property->setAccessible(true);
+                            $parent = $parent_property->getValue($fn[0]);
+                            if (!$parent || !method_exists($parent, 'get_data') || $parent->get_name() !== 'posts') return null;
+                            $item['parent'] = $parent->get_data();
+                            unset($item['parent']['_iu_fragment_build'], $item['parent']['_iu_fragment_payload']);
+                        }
+                    } else return null;
+                    $result[] = $item;
+                }
+            }
+        }
+        return $result;
+    }
+
+    private static function length_ok($value) {
+        return (is_int($value) || (is_string($value) && ctype_digit($value))) && (int) $value >= 0 && (int) $value <= 1000;
+    }
+
+    public static function replay($wanted) {
+        if (!is_array($wanted) || self::profile() === null) return false;
+        $skin = null;
+        $parent = null;
+        foreach ($wanted as $item) {
+            if (!is_array($item) || !in_array($item['hook'] ?? '', array('excerpt_length', 'excerpt_more'), true) ||
+                !is_int($item['priority'] ?? null) || !is_int($item['args'] ?? null) || $item['args'] !== 1) return false;
+            if (($item['kind'] ?? '') === 'native') {
+                if ($item['hook'] !== 'excerpt_more' || !function_exists('wp_embed_excerpt_more')) return false;
+            } elseif (($item['kind'] ?? '') === 'classic') {
+                if (!defined('ELEMENTOR_PRO_VERSION') || ELEMENTOR_PRO_VERSION !== '4.2.2') return false;
+                if ($item['hook'] === 'excerpt_length') {
+                    if (!self::length_ok($item['length'] ?? null)) return false;
+                    if (!is_array($item['parent'] ?? null) || ($item['parent']['widgetType'] ?? '') !== 'posts') return false;
+                    // Construct one lightweight control parent, never render it
+                    // or call get_query(). Preserve the real Widget_Base API
+                    // for subsequent skin/control work and exact callback IDs.
+                    $parent = \Elementor\Plugin::$instance->elements_manager->create_element_instance($item['parent']);
+                    if (!$parent || $parent->get_name() !== 'posts' ||
+                        $parent->get_settings('classic_excerpt_length') !== $item['length']) return false;
+                }
+                $widget = \Elementor\Plugin::$instance->widgets_manager->get_widget_types('posts');
+                $skin = $widget ? $widget->get_skin('classic') : null;
+                if (!$skin || get_class($skin) !== 'ElementorPro\\Modules\\Posts\\Skins\\Skin_Classic') return false;
+            } else return false;
+        }
+        if (self::profile() === $wanted) return true;
+        if ($skin && $parent) {
+            // Reuse the actual globally registered Skin_Classic object. A new
+            // constant callback would survive the next Posts widget's removal
+            // of its own filters and change subsequent excerpts. set_parent()
+            // uses the preserved control parent until a later real Posts
+            // widget binds its own parent before render.
+            $skin->set_parent($parent);
+        }
+        foreach (array('excerpt_length', 'excerpt_more') as $hook) remove_all_filters($hook);
+        foreach ($wanted as $item) {
+            $fn = $item['kind'] === 'native' ? 'wp_embed_excerpt_more' :
+                array($skin, $item['hook'] === 'excerpt_length' ? 'filter_excerpt_length' : 'filter_excerpt_more');
+            add_filter($item['hook'], $fn, $item['priority'], $item['args']);
+        }
+        return true;
+    }
+}
diff --git a/includes/elementor-fragment-cache-graph.php b/includes/elementor-fragment-cache-graph.php
new file mode 100644
--- /dev/null
+++ b/includes/elementor-fragment-cache-graph.php
@@ -0,0 +1,345 @@
+<?php
+/** Reviewed Elementor/Pro graph policy. No site, document or element IDs. */
+if (!defined('ABSPATH')) exit;
+
+final class IU_Elementor_Fragment_Graph {
+    private $stack = array();
+    private $seen = array();
+    private $signature = array();
+    private $styles = array();
+    private $scripts = array();
+    private $menus = array();
+    private $budget = 2500;
+    private $failure = '';
+
+    public static function prototype_supported($type, $prototype) {
+        $classes = array('heading' => 'Elementor\\Widget_Heading', 'image' => 'Elementor\\Widget_Image',
+            'button' => 'Elementor\\Widget_Button', 'icon' => 'Elementor\\Widget_Icon', 'icon-list' => 'Elementor\\Widget_Icon_List',
+            'divider' => 'Elementor\\Widget_Divider', 'spacer' => 'Elementor\\Widget_Spacer',
+            'nested-tabs' => 'Elementor\\Modules\\NestedTabs\\Widgets\\NestedTabs',
+            'mega-menu' => 'ElementorPro\\Modules\\MegaMenu\\Widgets\\Mega_Menu',
+            'template' => 'ElementorPro\\Modules\\Library\\Widgets\\Template',
+            'loop-grid' => 'ElementorPro\\Modules\\LoopBuilder\\Widgets\\Loop_Grid',
+            'posts' => 'ElementorPro\\Modules\\Posts\\Widgets\\Posts', 'nav-menu' => 'ElementorPro\\Modules\\NavMenu\\Widgets\\Nav_Menu');
+        $paths = array('nested-tabs' => 'modules/nested-tabs/widgets/nested-tabs.php',
+            'mega-menu' => 'modules/mega-menu/widgets/mega-menu.php', 'template' => 'modules/library/widgets/template.php',
+            'loop-grid' => 'modules/loop-builder/widgets/loop-grid.php', 'posts' => 'modules/posts/widgets/posts.php',
+            'nav-menu' => 'modules/nav-menu/widgets/nav-menu.php');
+        $supported = false;
+        if (is_string($type) && is_object($prototype) && isset($classes[$type]) && get_class($prototype) === $classes[$type]) {
+            $base = strpos($classes[$type], 'ElementorPro\\') === 0
+                ? (defined('ELEMENTOR_PRO_PATH') ? ELEMENTOR_PRO_PATH : '')
+                : (defined('ELEMENTOR_PATH') ? ELEMENTOR_PATH : '');
+            $expected = $base . ($paths[$type] ?? 'includes/widgets/' . $type . '.php');
+            $supported = $base && str_replace('\\', '/', (new ReflectionClass($prototype))->getFileName()) === str_replace('\\', '/', $expected);
+        }
+        return (bool) apply_filters('iu_elementor_fragment_prototype_supported', $supported, $type, $prototype);
+    }
+
+    public static function inspect($node) {
+        if (!in_array($node['widgetType'] ?? '', array('mega-menu', 'loop-grid', 'posts', 'template'), true) ||
+            !defined('ELEMENTOR_VERSION') || ELEMENTOR_VERSION !== '4.2.3' ||
+            !defined('ELEMENTOR_PRO_VERSION') || ELEMENTOR_PRO_VERSION !== '4.2.2' ||
+            !class_exists('Elementor\\Plugin') || !\Elementor\Plugin::$instance) return null;
+        $policy = new self();
+        if (!$policy->walk(array($node), false) || !$policy->hooks_safe()) {
+            do_action('iu_elementor_fragment_graph_rejected', $policy->failure ?: 'unknown-hook', $node);
+            return null;
+        }
+        return array('signature' => hash('sha256', wp_json_encode($policy->signature)),
+            'dependencies' => array('styles' => array_keys($policy->styles), 'scripts' => array_keys($policy->scripts)),
+            'independent_query' => true);
+    }
+
+    private function fail($reason) { $this->failure = $reason; return false; }
+
+    private function walk($nodes, $loop) {
+        foreach ($nodes as $node) {
+            if (!is_array($node) || --$this->budget < 0) return $this->fail('graph-budget');
+            $type = $node['widgetType'] ?? $node['elType'] ?? '';
+            if (!in_array($type, array('container', 'section', 'column', 'mega-menu', 'template', 'nested-tabs',
+                'heading', 'image', 'button', 'icon', 'icon-list', 'divider', 'spacer', 'nav-menu', 'loop-grid', 'posts'), true)) {
+                return $this->fail('unsupported-widget:' . $type);
+            }
+            $settings = $node['settings'] ?? array();
+            if (!$this->settings_safe($settings, $loop, $type)) return false;
+            if (in_array($type, array('loop-grid', 'posts'), true) && !$this->query_safe($settings, $type)) return false;
+            if ($type === 'nav-menu') {
+                $menu = wp_get_nav_menu_object($settings['menu'] ?? '');
+                if (!$menu) return $this->fail('unresolved-menu');
+                $this->menus[$menu->slug] = true;
+                if (defined('ICL_LANGUAGE_CODE')) {
+                    $translated = apply_filters('wpml_object_id', $menu->term_id, 'nav_menu', true, ICL_LANGUAGE_CODE);
+                    $translated_menu = wp_get_nav_menu_object($translated);
+                    if ($translated_menu) $this->menus[$translated_menu->slug] = true;
+                }
+            }
+            if (!in_array($type, array('container', 'section', 'column'), true)) {
+                $prototype = \Elementor\Plugin::$instance->widgets_manager->get_widget_types($type);
+                if (!$prototype || !self::prototype_supported($type, $prototype)) return $this->fail('unsupported-widget-implementation:' . $type);
+                foreach ($prototype->get_style_depends() as $handle) $this->styles[$handle] = true;
+                foreach ($prototype->get_script_depends() as $handle) $this->scripts[$handle] = true;
+            }
+            if (in_array($type, array('template', 'loop-grid'), true)) {
+                $id = absint($settings['template_id'] ?? 0);
+                if (!$id) return $this->fail('missing-template');
+                $mode = $type === 'loop-grid';
+                $identity = $id . ':' . (int) $mode;
+                if (isset($this->stack[$identity])) return $this->fail('template-cycle');
+                if (!isset($this->seen[$identity])) {
+                    $raw = get_post_meta($id, '_elementor_data', true);
+                    $data = is_string($raw) ? json_decode($raw, true) : null;
+                    if (!is_array($data) || !$data || get_post_status($id) !== 'publish') return $this->fail('unresolved-template');
+                    $this->signature[$identity] = hash('sha256', $raw);
+                    $this->stack[$identity] = true;
+                    if (!$this->walk($data, $mode)) return false;
+                    unset($this->stack[$identity]);
+                    $this->seen[$identity] = true;
+                }
+                // Template widgets print external document CSS; loop-template CSS
+                // is emitted inside the fragment. WPML-filtered render-copy nodes
+                // determine the effective reference IDs for the current language.
+                if ($type === 'template') $this->styles['elementor-post-' . $id] = true;
+            }
+            if (!empty($node['elements']) && !$this->walk($node['elements'], $loop)) return false;
+        }
+        return true;
+    }
+
+    private function settings_safe($settings, $loop, $type) {
+        foreach ($settings as $key => $value) {
+            if (preg_match('/display.condition|visibility.condition|shortcode|search_filter_query/', $key) && !empty($value)) {
+                return $this->fail('conditional-setting:' . $key);
+            }
+            if ($key === '__dynamic__') {
+                if (!array_filter((array) $value)) continue;
+                if (!$loop || !in_array($type, array('image', 'heading', 'button', 'icon-list'), true)) return $this->fail('dynamic-context');
+                foreach ((array) $value as $tag) {
+                    if (!is_string($tag) || !preg_match('/^\[elementor-tag\s+id="[^"]+"\s+name="(post-url|post-featured-image|post-title)"\s+settings="([^"]*)"\]$/', $tag, $match) ||
+                        json_decode(rawurldecode($match[2]), true) !== array()) return $this->fail('dynamic-tag');
+                }
+            } elseif (is_array($value) && !$this->settings_safe($value, $loop, $type)) return false;
+        }
+        return true;
+    }
+
+    private function query_safe($settings, $type) {
+        $prefix = $type === 'posts' ? 'posts_' : 'post_query_';
+        $post_type = $settings[$prefix . 'post_type'] ?? 'post';
+        $object = is_string($post_type) ? get_post_type_object($post_type) : null;
+        if (!$object || !$object->public || in_array($post_type, array('product', 'product_variation', 'attachment'), true)) return $this->fail('query-source');
+        if (!empty($settings[$prefix . 'query_id']) || !empty($settings['pagination_type']) ||
+            !empty($settings['pagination_individual']) || !empty($settings[$prefix . 'avoid_duplicates']) ||
+            !empty($settings['nothing_found_message']) || !empty($settings['search_filter_query'])) return $this->fail('interactive-query');
+        if (!in_array($settings[$prefix . 'orderby'] ?? 'date', array('date', 'title', 'menu_order', 'modified', 'ID'), true)) return $this->fail('query-order');
+        foreach (array('include', 'exclude') as $key) {
+            if (array_diff((array) ($settings[$prefix . $key] ?? array()), array('terms', 'authors', 'manual_selection'))) return $this->fail('relative-query');
+        }
+        foreach ($settings as $key => $value) {
+            if (strpos($key, $prefix) === 0 && preg_match('/search|current|related|date|offset/', $key) && !empty($value)) return $this->fail('context-query');
+        }
+        foreach ((array) ($settings['alternate_templates'] ?? array()) as $alternate) {
+            if (!empty($alternate['template_id'])) return $this->fail('alternate-template');
+        }
+        if ($type === 'posts' && !in_array($settings['_skin'] ?? 'classic', array('classic'), true)) return $this->fail('posts-skin');
+        // Visible excerpts can run arbitrary the_content/block/opt-in filters.
+        // The reviewed hidden-excerpt path only leaves known scalar skin hooks.
+        if ($type === 'posts' && ($settings['classic_show_excerpt'] ?? 'yes') !== '') return $this->fail('posts-excerpt');
+        if ($type === 'loop-grid' && !in_array($settings['_skin'] ?? 'post', array('post'), true)) return $this->fail('loop-skin');
+        return true;
+    }
+
+    private function hooks_safe() {
+        $hooks = array('elementor/widget/render_content',
+            'elementor/frontend/widget/before_render', 'elementor/frontend/widget/after_render',
+            'elementor/frontend/before_render', 'elementor/frontend/after_render', 'elementor/frontend/the_content',
+            'elementor/query/query_args', 'elementor/query/query_results', 'pre_get_posts', 'posts_pre_query', 'posts_clauses', 'posts_results', 'the_posts',
+            'pre_wp_nav_menu', 'wp_nav_menu_args', 'wp_nav_menu_objects', 'wp_nav_menu_items',
+            'nav_menu_css_class', 'nav_menu_link_attributes', 'walker_nav_menu_start_el',
+            'get_post_metadata', 'post_link', 'post_type_link', 'get_the_excerpt',
+            'posts_where', 'posts_join', 'posts_where_paged', 'posts_join_paged', 'posts_fields', 'posts_orderby',
+            'posts_groupby', 'posts_distinct', 'post_limits', 'posts_clauses_request', 'posts_request',
+            'posts_where_request', 'posts_join_request', 'posts_fields_request', 'posts_orderby_request',
+            'posts_groupby_request', 'posts_distinct_request', 'post_limits_request',
+            'the_title', 'get_the_date', 'get_the_time', 'excerpt_length', 'excerpt_more', 'post_thumbnail_html',
+            'wp_get_attachment_url', 'wp_get_attachment_image_src', 'wp_get_attachment_image_attributes',
+            'get_the_post_thumbnail_url', 'get_the_terms', 'image_downsize', 'get_attached_file', 'post_class',
+            'elementor/image_size/get_attachment_image_html', 'wp_get_attachment_image', 'wp_get_attachment_image_context',
+            'pre_wp_get_loading_optimization_attributes', 'wp_get_loading_optimization_attributes',
+            'wp_loading_optimization_force_header_contexts', 'wp_lazy_loading_enabled',
+            'wp_min_priority_img_pixels', 'wp_omit_loading_attr_threshold',
+            'do_rocket_lazyload', 'do_rocket_lazyload_iframes',
+            'wp_get_attachment_metadata', 'wp_calculate_image_srcset', 'wp_calculate_image_sizes', 'nav_menu_item_title');
+        // Root builder callbacks have already run, and their result is keyed.
+        // Referenced documents, however, are not rendered on a root hit; their
+        // builder callbacks need an independent compatibility review.
+        if ($this->seen) $hooks[] = 'elementor/frontend/builder_content_data';
+        foreach ($hooks as $hook) {
+            foreach (($GLOBALS['wp_filter'][$hook]->callbacks ?? array()) as $group) {
+                foreach ($group as $callback) {
+                    if (!$this->callback_safe($callback['function'], $hook)) return $this->fail('unknown-hook:' . $hook);
+                }
+            }
+        }
+        return true;
+    }
+
+    private function callback_safe($callback, $hook) {
+        if (apply_filters('iu_elementor_fragment_graph_callback_allowed', false, $callback, $hook)) return true;
+        if ($callback instanceof Closure) return $this->wpml_wrapper_safe($callback, $hook);
+        $name = is_array($callback) ? (is_object($callback[0]) ? get_class($callback[0]) : $callback[0]) . '::' . $callback[1] : $callback;
+        if (!is_string($name)) return false;
+        if (in_array($name, array('IU_Elementor_Fragment_Cache::filter', 'IU_Elementor_Fragment_Cache::begin',
+            'IU_Elementor_Fragment_Cache::finish', 'IU_Elementor_Fragment_Cache::query_results',
+            'iu_elementor_filter_builder_content_by_device'), true)) return true;
+        if (in_array($name, array('ElementorPro\\Modules\\DisplayConditions\\Module::before_element_render',
+            'ElementorPro\\Modules\\DisplayConditions\\Module::after_element_render',
+            'ElementorPro\\Modules\\LoopBuilder\\Module::filter_content_data',
+            'ElementorPro\\Modules\\LoopFilter\\Module::filter_loop_query', 'ElementorPro\\Modules\\Search\\Module::set_query',
+            'Elementor\\Frontend::start_excerpt_flag', 'Elementor\\Frontend::end_excerpt_flag',
+            'ElementorPro\\Modules\\Posts\\Skins\\Skin_Classic::filter_excerpt_length',
+            'ElementorPro\\Modules\\Posts\\Skins\\Skin_Classic::filter_excerpt_more'), true)) return true;
+        if (in_array($name, array('Search_Filter_Elementor_Extension\\Version_2\\Plugin::filter_posts_render',
+            'Search_Filter_Elementor_Extension\\Version_2\\Plugin::before_render_products_element',
+            'Search_Filter_Elementor_Extension\\Version_2\\Plugin::after_render_products_element',
+            'Search_Filter_Elementor_Extension\\Version_2\\Plugin::before_render_products_loop_grid_element',
+            'Search_Filter_Elementor_Extension\\Version_2\\Plugin::after_render_products_loop_grid_element',
+            'Search_Filter_Elementor_Extension\\Version_2\\Plugin::attach_sf_to_posts',
+            'Search_Filter_Elementor_Extension\\Version_2\\Plugin::attach_sf_to_post_loop_grid'), true) &&
+            defined('Search_Filter_Elementor_Extension::VERSION') && \Search_Filter_Elementor_Extension::VERSION === '1.4.1') return true;
+        if (in_array($name, array('Search_Filter::archive_query_init_later', 'Search_Filter::custom_query_init'), true) &&
+            defined('SEARCH_FILTER_VERSION') && SEARCH_FILTER_VERSION === '2.5.17') return true;
+        if (in_array($name, array('IS_Public::pre_get_posts', 'IS_Public::posts_join', 'IS_Public::posts_distinct_request'), true) && defined('IS_VERSION') && IS_VERSION === '5.5.16') return true;
+        if ($name === 'ACF::posts_where' && defined('ACF_VERSION') && ACF_VERSION === '6.8.8') return true;
+        if ($name === 'WP_Rocket\\Engine\\Media\\Lazyload\\Subscriber::maybe_disable_core_lazyload' &&
+            defined('WP_ROCKET_VERSION') && WP_ROCKET_VERSION === '3.23.2.2') {
+            $file = str_replace('\\', '/', (new ReflectionMethod($callback[0], $callback[1]))->getFileName());
+            if ($file !== str_replace('\\', '/', WP_PLUGIN_DIR) . '/wp-rocket/inc/Engine/Media/Lazyload/Subscriber.php') return false;
+            foreach (array('do_rocket_lazyload', 'do_rocket_lazyload_iframes') as $nested_hook) {
+                foreach (($GLOBALS['wp_filter'][$nested_hook]->callbacks ?? array()) as $group) {
+                    foreach ($group as $entry) if (!$this->callback_safe($entry['function'], $nested_hook)) return false;
+                }
+            }
+            // This reviewed callback only reads Rocket's lazyload options and
+            // constant/boolean filters. Preserve their effective values in keys.
+            $this->signature['rocket-lazyload'] = array($callback[0]->maybe_disable_core_lazyload(true, 'img'),
+                $callback[0]->maybe_disable_core_lazyload(true, 'iframe'));
+            return true;
+        }
+        if ($name === 'ewww_image_optimizer_pte_check' && defined('EWWW_IMAGE_OPTIMIZER_VERSION') &&
+            EWWW_IMAGE_OPTIMIZER_VERSION === 880 && empty($_GET['pte-action'])) return true;
+        if (in_array($name, array('RankMath\\Common::post_type_link', 'RankMath\\Common::reorder_the_terms'), true) &&
+            defined('RANK_MATH_VERSION') && RANK_MATH_VERSION === '1.0.277.2') return true;
+        if ($name === 'remove_cpt_base::remove_slug' && is_array($callback) && is_object($callback[0])) {
+            $file = (new ReflectionMethod($callback[0], $callback[1]))->getFileName();
+            $header = get_file_data($file, array('Version' => 'Version'));
+            if (($header['Version'] ?? '') !== '6.7') return false;
+            // The reviewed callback's only mutation trims rewrite slugs. Require
+            // that normalization to be done already, so hits skip no mutation.
+            foreach ($GLOBALS['wp_post_types'] ?? array() as $post_type) {
+                if (isset($callback[0]->rcptb_selected[$post_type->name]) &&
+                    $post_type->rewrite['slug'] !== trim($post_type->rewrite['slug'], '/')) return false;
+            }
+            $this->signature['remove-cpt-base'] = $callback[0]->rcptb_selected;
+            return true;
+        }
+        if ($name === 'IS_Public::wp_nav_menu_items' && defined('IS_VERSION') && IS_VERSION === '5.5.16') {
+            $options = array_merge((array) get_option('is_settings', array()), (array) get_option('is_menu_search', array()));
+            if (isset($options['menus'][''])) return false;
+            foreach (array_keys($this->menus) as $slug) if (isset($options['menu_name'][$slug])) return false;
+            return true;
+        }
+        try {
+            $reflection = is_array($callback) ? new ReflectionMethod($callback[0], $callback[1]) : new ReflectionFunction($callback);
+            $file = str_replace('\\', '/', (string) $reflection->getFileName());
+            if (in_array($name, array('wp_trim_excerpt', '_close_comments_for_old_posts',
+                'wp_nav_menu_remove_menu_item_has_children_class', 'wp_embed_excerpt_more',
