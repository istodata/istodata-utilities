+                if ($item['hook'] === 'excerpt_length') {
+                    if (!self::length_ok($item['length'] ?? null)) return false;
+                    if (!is_array($item['parent'] ?? null) || ($item['parent']['widgetType'] ?? '') !== 'posts') return false;
