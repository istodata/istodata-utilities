+            if ($name === 'WPML\\CF7\\Locale::getFormLocale' &&
+                preg_match('~/contact-form-7-multilingual/classes/Locale.php$~', $file)) {
+                $header = get_file_data(dirname($file, 2) . '/plugin.php', array('Version' => 'Version'));
+                return ($header['Version'] ?? '') === '1.3.3';
+            }
+            if ($name === 'WPML\\WPSEO\\RankMathSEO\\PrimaryCategory\\Hooks::translateTermId' &&
+                preg_match('~/wp-seo-multilingual/classes/Shared/PrimaryCategory/BaseHooks.php$~', $file)) {
+                $header = get_file_data(dirname($file, 4) . '/plugin.php', array('Version' => 'Version'));
+                return ($header['Version'] ?? '') === '2.2.5';
