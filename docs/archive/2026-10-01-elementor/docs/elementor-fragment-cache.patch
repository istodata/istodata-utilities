+    }
+
+    private function wpml_wrapper_safe($callback, $hook) {
+        if (!defined('ICL_SITEPRESS_VERSION') || ICL_SITEPRESS_VERSION !== '4.9.7') return false;
+        $expected = array('elementor/frontend/builder_content_data' => 'WPML\\PB\\Elementor\\V4\\Hooks::translateContentIds',
+            'get_post_metadata' => 'WPML\\PB\\Elementor\\Hooks\\QueryFilter::translateQueryIds');
+        if (!isset($expected[$hook])) return false;
+        // Inspect the reviewed Promise/spreadArgs/withoutRecursion wrappers,
+        // rather than trusting every closure from the WPML Hooks.php file.
+        $seen = new SplObjectStorage();
+        $leaves = array();
+        $budget = 80;
+        $check = function ($value) use (&$check, &$budget, &$leaves, $seen, $expected, $hook) {
+            if (--$budget < 0) return false;
+            if (is_array($value) && is_callable($value)) {
+                $name = (is_object($value[0]) ? get_class($value[0]) : $value[0]) . '::' . $value[1];
+                if ($name !== $expected[$hook]) return false;
+                $ref = new ReflectionMethod($value[0], $value[1]);
+                if (strpos(str_replace('\\', '/', $ref->getFileName()), '/sitepress-multilingual-cms/addons/wpml-page-builders/') === false) return false;
+                $leaves[$name] = true;
+                return true;
+            }
+            if (is_array($value)) {
+                foreach ($value as $item) if (!$check($item)) return false;
+                return true;
+            }
+            if (!is_object($value)) return !is_callable($value);
+            if ($seen->contains($value)) return true;
+            $seen->attach($value);
+            if ($value instanceof Closure) {
+                $ref = new ReflectionFunction($value);
+                $file = str_replace('\\', '/', $ref->getFileName());
+                $range = $ref->getStartLine() . ':' . $ref->getEndLine();
+                $allowed = array('/vendor/wpml/wp/classes/Hooks.php' => array('27:29'),
+                    '/vendor/wpml/fp/core/functions.php' => array('8:10', '67:90', '68:89'),
+                    '/vendor/wpml/fp/core/Fns.php' => array('44:44', '235:247'));
+                $trusted = false;
+                foreach ($allowed as $suffix => $ranges) {
+                    if (strpos($file, '/sitepress-multilingual-cms') !== false && substr($file, -strlen($suffix)) === $suffix &&
+                        in_array($range, $ranges, true)) $trusted = true;
+                }
+                if (!$trusted) return false;
+                foreach ($ref->getStaticVariables() as $item) if (!$check($item)) return false;
+                return true;
+            }
+            if (get_class($value) !== 'WPML\\FP\\Promise') return false;
+            foreach (array('onResolved', 'onReject', 'next') as $property) {
+                $ref = new ReflectionProperty($value, $property);
+                if (PHP_VERSION_ID < 80100) $ref->setAccessible(true);
+                if (!$check($ref->getValue($value))) return false;
+            }
+            return true;
+        };
+        try { return $check($callback) && isset($leaves[$expected[$hook]]); }
+        catch (ReflectionException $exception) { return false; }
+    }
+}
