+            'label' => __('Διάρκεια', 'istodata-utilities'),
+            'type' => \Elementor\Controls_Manager::SELECT,
+            'options' => array('3600' => '1 ώρα', '21600' => '6 ώρες', '86400' => '24 ώρες', '604800' => '7 ημέρες'),
